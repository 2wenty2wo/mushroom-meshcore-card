{
  "name": "mushroom-meshcore-card",
  "version": "0.20.1",
  "description": "Mushroom-styled Home Assistant Lovelace cards for MeshCore",
  "homepage": "https://2wenty2wo.github.io/mushroom-meshcore-card/",
  "repository": {
    "type": "git",
    "url": "https://github.com/2wenty2wo/mushroom-meshcore-card.git"
  },
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "watch": "rollup -c rollup.config.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:render": "node scripts/render-smoke.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "dev": "npm run typecheck && npm run watch",
    "translate": "node scripts/translate.mjs",
    "translate:dry": "node scripts/translate.mjs --dry-run",
    "check-translations": "node scripts/check-translations.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^11.1.6",
    "@vitest/coverage-v8": "^3.2.7",
    "happy-dom": "^20.11.6",
    "home-assistant-js-websocket": "^9.4.0",
    "rollup": "^4.62.0",
    "tslib": "^2.6.3",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.7",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "vite": "6.4.3"
  }
}
